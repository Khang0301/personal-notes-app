# Copy this file to .env and fill in real values. Never commit the real .env file.

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=notesapp;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd

# Must be a long, random string (32+ characters) — used to sign JWTs.
# You can generate one with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying

# Must match the URL the frontend is served from (for CORS).
FRONTEND_URL=http://localhost:5173
